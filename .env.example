# ── Required ────────────────────────────────────────────────────────

# Postgres connection string (Railway, Neon, Supabase, …).
# DATABASE_URL is also accepted.
POSTGRES_URL=postgres://user:pass@host:5432/dbname

# Card identification from photos. Free key: https://aistudio.google.com/apikey
# Without this, scanning is disabled. It never sets prices.
GEMINI_API_KEY=

# ── Price sources ───────────────────────────────────────────────────
# Each card's price is the median of the sources that agree, so more keys
# means better prices. With only one source live, every price is a single
# opinion and is shown with low confidence.

# Free tier works without a key, just rate-limited: https://pokemontcg.io
POKEMON_TCG_KEY=

# https://scrydex.com — both values are needed
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=

# https://justtcg.com
JUSTTCG_API_KEY=

# ── Optional ────────────────────────────────────────────────────────

# How often every card is re-checked against the marketplaces, in days.
# 1 = daily (default), 2 = every other day, 0.5 = twice a day.
# Lower means fresher prices and more API calls; the free sources have rate
# limits, so daily is a sensible floor for a large collection.
PRICE_REFRESH_DAYS=1

# Shared secret for GET /api/cron/refresh-prices
CRON_SECRET=

# Local dev only
PORT=3000
