# Get a free Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Postgres connection string (Neon, Railway, Supabase, etc.)
POSTGRES_URL=postgres://user:pass@host:5432/dbname

# JWT secret for auth tokens (change in production!)
JWT_SECRET=your-secret-key-here

# Optional: Vercel Cron secret (auto-set by Vercel)
CRON_SECRET=

# Optional: Pokemon TCG API key (https://pokemontcg.io)
POKEMON_TCG_API_KEY=

# Optional: Scrydex API credentials
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=

# Dashboard port (local dev only)
PORT=3000
